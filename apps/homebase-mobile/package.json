{
  "name": "@homebase/homebase-mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "eas-build-pre-install": "cd ../../ && node tools/scripts/eas-build-pre-install.mjs . apps/homebase-mobile",
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/homebase-mobile"
  },
  "dependencies": {
    "@expo/metro": "*",
    "@expo/vector-icons": "*",
    "@react-native-async-storage/async-storage": "*",
    "@react-native-community/datetimepicker": "*",
    "@react-native-community/slider": "*",
    "@testing-library/react-native": "*",
    "expo": "*",
    "expo-splash-screen": "*",
    "expo-status-bar": "*",
    "expo-system-ui": "*",
    "jest-expo": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*",
    "react-native-svg-transformer": "*",
    "react-native-web": "*",
    "react-native-worklets": "*"
  },
  "nx": {
    "tags": [
      "type:app"
    ],
    "targets": {
      "build": {
        "command": "expo export --platform ios --platform android --output-dir dist --clear",
        "options": {
          "cwd": "apps/homebase-mobile"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tailwind.config.js"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
